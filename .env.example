APP_ENV=local
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/primerep

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Required for the exercise Q&A feature (POST /v1/exercises/{id}/ask).
# Not required for the app to boot or for most tests — the feature returns a
# 503 at call time if this is missing.
ANTHROPIC_API_KEY=
# Optional overrides — sensible defaults are used if unset.
# ANTHROPIC_QA_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_SEED_MODEL=claude-sonnet-4-5-20250929
