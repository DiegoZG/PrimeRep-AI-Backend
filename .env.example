APP_ENV=local
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/primerep

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated browser origins. Mobile native clients do not send CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Redis URL in deployed multi-worker environments; memory:// is local/test only.
RATE_LIMIT_STORAGE_URI=memory://

# Required for the exercise Q&A feature (POST /v1/exercises/{id}/ask).
# Not required for the app to boot or for most tests — the feature returns a
# 503 at call time if this is missing.
ANTHROPIC_API_KEY=
# Optional overrides — sensible defaults are used if unset.
# ANTHROPIC_QA_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_SEED_MODEL=claude-sonnet-4-5-20250929

# Object storage for exercise footage. Read only by
# scripts/upload_local_footage.py — the API never touches these, so leaving
# them blank does not affect the running app.
ASSET_BUCKET=
# Public CDN origin that fronts the bucket. Uploaded objects become
# <ASSET_CDN_BASE_URL>/<key>, and that URL is what gets written to the
# exercises table, so it must be publicly readable.
ASSET_CDN_BASE_URL=
# Leave unset for AWS S3. For Cloudflare R2, set this to
# https://<account-id>.r2.cloudflarestorage.com
ASSET_S3_ENDPOINT_URL=
# S3 region. R2 ignores this but still requires a value; "auto" is correct there.
ASSET_S3_REGION=auto
# Credentials come from the standard AWS environment variables or shared
# config file: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
