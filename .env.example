APP_ENV=local
# Immutable user UUIDs allowed to manage flags; comma-separated, empty denies all.
FEATURE_FLAG_ADMIN_USER_IDS=
RELEASE_VERSION=local
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/primerep

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated browser origins. Mobile native clients do not send CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Redis URL in deployed multi-worker environments; memory:// is local/test only.
RATE_LIMIT_STORAGE_URI=memory://

# Required in production for password-reset email delivery. The reset URL must
# be an HTTPS frontend route such as https://app.example.com/reset-password.
RESEND_API_KEY=
EMAIL_FROM=PrimeRep <support@example.com>
EMAIL_OUTBOX_ENCRYPTION_KEY=
# Generate a Fernet key in production and retain it in the secret store.
PASSWORD_RESET_URL_BASE=http://localhost:8081/reset-password

# Copy only needed values into the deployment's ignored environment file.
# Keep this blank in automated QA. Never put a real key in source control.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_CHAT_REASONING=none
OPENAI_VISION_REASONING=none
# Shared application ledger across all OpenAI chat/draft/scan calls in this DB/environment.
# These limits do not provision provider credit or authorize automated inference.
OPENAI_TEST_BUDGET_USD=10
OPENAI_DAILY_BUDGET_USD=10
OPENAI_MONTHLY_BUDGET_USD=10
EQUIPMENT_SCAN_ATTEMPTS_PER_MINUTE=3
EQUIPMENT_SCAN_ATTEMPTS_PER_DAY=20
EQUIPMENT_SCAN_GLOBAL_CONCURRENCY=2
EQUIPMENT_SCAN_MAX_EDGE=1024
EQUIPMENT_SCAN_TIMEOUT_SECONDS=20
# Enable only through the existing audited, selected-user feature-flag controls.
# Do not enable OPENAI_LOG/debug HTTP payload logging.

# Optional bearer token for Expo's push API. Recommended in production.
EXPO_ACCESS_TOKEN=

# Object storage for operator-run footage tooling. Originals and unapproved
# derivatives stay in a PRIVATE bucket with public access disabled.
ASSET_STAGING_BUCKET=
# Separate public bucket: only approved derivatives/posters are copied here.
ASSET_BUCKET=
# Production HTTPS custom media domain; do not use an r2.dev development URL.
# Example: https://media.example.com (no credentials, query or fragment).
ASSET_CDN_BASE_URL=
# Leave unset for AWS S3. For Cloudflare R2, set this to
# https://<account-id>.r2.cloudflarestorage.com
ASSET_S3_ENDPOINT_URL=
# S3 region. R2 ignores this but still requires a value; "auto" is correct there.
ASSET_S3_REGION=auto
# Credentials come from the standard AWS environment variables or shared
# config file: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
